{%- comment -%}
Local override of al_folio_core's footer.liquid.
Instead of a full-width copyright/credits bar, the info is tucked behind a small
ⓘ button (click to reveal), so it stays unobtrusive.
{%- endcomment -%}
{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

<footer class="{% if site.footer_fixed %}fixed-bottom{% else %}sticky-bottom mt-5{% endif %}" role="contentinfo">
  <div class="container text-center">
    <details class="footer-info">
      <summary aria-label="Site information and credits" title="Site information and credits">&#9432;</summary>
      <div class="footer-info-content">{{ footer_contents }}</div>
    </details>
  </div>
</footer>

<style>
  .footer-info {
    display: inline-block;
    position: relative;
    line-height: 1;
  }
  .footer-info > summary {
    list-style: none;
    cursor: pointer;
    font-size: 1.15rem;
    color: var(--global-text-color-light);
    opacity: 0.45;
    transition: opacity 0.15s ease;
    display: inline-block;
    padding: 0.15rem;
  }
  .footer-info > summary::-webkit-details-marker {
    display: none;
  }
  .footer-info > summary:hover,
  .footer-info[open] > summary {
    opacity: 0.9;
  }
  .footer-info-content {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: min(340px, 90vw);
    background: var(--global-bg-color);
    border: 1px solid var(--global-divider-color);
    border-radius: 7px;
    padding: 0.6rem 0.8rem;
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: left;
    color: var(--global-text-color-light);
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.16);
    z-index: 20;
  }
  .footer-info-content a {
    color: var(--global-theme-color);
  }
</style>

{% if site.enable_darkmode %}
  <!-- Automatic light/dark only: force the theme setting to "system" so it always -->
  <!-- follows the OS (the manual toggle is hidden via CSS). Self-heals any stored -->
  <!-- light/dark preference from earlier visits. -->
  <script>
    try {
      if (localStorage.getItem("theme") !== "system" && typeof setThemeSetting === "function") {
        setThemeSetting("system");
      }
    } catch (e) {}
  </script>
{% endif %}

{% if site.analytics.cloudflare %}
  <!-- Cloudflare Web Analytics -->
  <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.analytics.cloudflare }}"}'></script>
  <!-- End Cloudflare Web Analytics -->
{% endif %}
